  "narrative": {
    "northStar": "The Shop in Your Hand",
    "overview": "The storefront behaves like a shoe-shop app held on a phone: the catalogue is the interface. Grey product tiles carry two round controls (add to cart, save), a pill search sits above a row of category chips, and a tab bar with a raised black Home disc anchors every page on phones. Nothing is decorative for its own sake; every visible control works.\n\nThe world is monochrome on purpose. White pages, light-grey tiles and ink-black controls stay quiet so the client's photographs of real leather, suede and cork supply all the colour. The only other hue is the red of a saved heart. Hero photography is shown in black and white; product photography never is.\n\nDensity is phone-first and generous: 44px touch targets, 48px buttons, two-up product grids on phones growing to four on desktop. Motion is small and physical: presses shrink to 97%, a saved heart pops once, and the product stand turns to its next photo.",
    "keyCharacteristics": [
      "Monochrome chrome, full-colour product photos, black and white hero photos.",
      "Poppins throughout; bold uppercase only for the hero and display moments.",
      "Small-radius slab buttons, pill search and stepper, round icon buttons.",
      "Product tiles with a cart button top left and a heart top right.",
      "A ring \"stand\" under the product photo on product pages."
    ],
    "rules": [
      {
        "name": "The Photos Carry Colour Rule",
        "body": "Interface colour is ink, white and grey. Colour on a screen comes from product photography or the saved heart, never from fills, gradients or accents.",
        "section": "colors"
      },
      {
        "name": "The Gold Stays In The Logo Rule",
        "body": "LP gold appears only inside the logo artwork (owner's decision, 2026-10-15).",
        "section": "colors"
      },
      {
        "name": "The No Kicker Rule",
        "body": "No small label or eyebrow above a heading. Supporting facts go below the heading (for example \"Handmade to order · Slides & palms\" under a product name).",
        "section": "typography"
      },
      {
        "name": "The One Elevation Rule",
        "body": "A surface declares depth once: hairline border (filters panel, receipt) or shadow (tiles, cart summary), never a border under a soft shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use Workshop Ink (#111111) for every primary action and selected state.",
      "**Do** show hero photography in black and white and product photography in full colour.",
      "**Do** give every control a 44px touch target and a working action; hide what would do nothing.",
      "**Do** put supporting facts under headings, and use tabular figures for prices and counts.",
      "**Do** keep bottom space for the phone tab bar on every page."
    ],
    "donts": [
      "**Don't** add colour fills, gradients or accent hues to the interface; the photos carry the colour.",
      "**Don't** use LP gold outside the logo.",
      "**Don't** put a kicker or eyebrow label above a heading.",
      "**Don't** stack a border under a soft shadow, or round cards beyond 16px.",
      "**Don't** use emoji or text glyphs as icons; use the shared 24px, 1.8-stroke icon set (components/Icon.tsx).",
      "**Don't** show ratings, review counts or badges the shop doesn't have."
    ]
  }
}
